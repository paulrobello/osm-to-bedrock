<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tiny synthetic OSM extract for the server-API integration tests.

  Drives the `/parse` happy path (handler honours the `.osm` suffix and parses
  as XML) and is the source for `sample.osm.pbf`, which drives `/convert` →
  `/status` → `/download` (that handler hard-codes a `.osm.pbf` temp suffix).

  Contains exactly: 1 residential road (3 nodes), 1 building (4-node closed
  polygon), 1 water body (4-node closed polygon) — 11 nodes, 3 ways. Stats
  counts in `tests/server_api.rs` are pinned to these.
-->
<osm version="0.6" generator="osm-to-bedrock-test-fixture">
  <bounds minlat="51.50000" minlon="-0.10000" maxlat="51.50080" maxlon="-0.09920"/>
  <!-- Road (way 100): open way, highway=residential -->
  <node id="1" lat="51.50010" lon="-0.09990"/>
  <node id="2" lat="51.50010" lon="-0.09960"/>
  <node id="3" lat="51.50010" lon="-0.09930"/>
  <way id="100">
    <nd ref="1"/>
    <nd ref="2"/>
    <nd ref="3"/>
    <tag k="highway" v="residential"/>
    <tag k="name" v="Test Road"/>
  </way>
  <!-- Building (way 200): closed polygon, building=yes -->
  <node id="10" lat="51.50030" lon="-0.09980"/>
  <node id="11" lat="51.50030" lon="-0.09960"/>
  <node id="12" lat="51.50050" lon="-0.09960"/>
  <node id="13" lat="51.50050" lon="-0.09980"/>
  <way id="200">
    <nd ref="10"/>
    <nd ref="11"/>
    <nd ref="12"/>
    <nd ref="13"/>
    <nd ref="10"/>
    <tag k="building" v="yes"/>
  </way>
  <!-- Water (way 300): closed polygon, natural=water -->
  <node id="20" lat="51.50060" lon="-0.09950"/>
  <node id="21" lat="51.50060" lon="-0.09930"/>
  <node id="22" lat="51.50075" lon="-0.09930"/>
  <node id="23" lat="51.50075" lon="-0.09950"/>
  <way id="300">
    <nd ref="20"/>
    <nd ref="21"/>
    <nd ref="22"/>
    <nd ref="23"/>
    <nd ref="20"/>
    <tag k="natural" v="water"/>
  </way>
</osm>
